# Copy to infra/deploy.env. This file contains public identifiers only.
# Use the same existing Firebase + Google Cloud project, with billing enabled.
PROJECT_ID=YOUR_GOOGLE_CLOUD_PROJECT_ID
REGION=asia-south1
FIRESTORE_LOCATION=asia-south1
REPOSITORY=returnradar
API_SERVICE=returnradar-api
WORKER_SERVICE=returnradar-worker
QUEUE=returnradar-work
GEMINI_MODEL=gemini-3.1-flash-lite
# Firebase console > Project settings > General > Your apps > Web app.
FIREBASE_WEB_API_KEY=YOUR_FIREBASE_WEB_API_KEY
# Google sign-in setup: an email authorized to manage this project's OAuth brand.
# This is public support contact information, not a password or credential.
FIREBASE_SUPPORT_EMAIL=YOUR_GOOGLE_ACCOUNT_EMAIL
# Optional: defaults to PROJECT_ID.web.app, served by Firebase Hosting.
# FIREBASE_AUTH_DOMAIN=YOUR_GOOGLE_CLOUD_PROJECT_ID.web.app
# CORS_ORIGINS=https://YOUR_GOOGLE_CLOUD_PROJECT_ID.web.app,https://YOUR_GOOGLE_CLOUD_PROJECT_ID.firebaseapp.com
# After `build`, deploy uses the saved immutable digest in infra/generated/image.txt.
# IMAGE=asia-south1-docker.pkg.dev/PROJECT_ID/returnradar/returnradar@sha256:...
