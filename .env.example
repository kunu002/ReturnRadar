# Local accounts use private SQLite workspaces. Demo data is available explicitly.
DEMO_MODE=true
AUTH_PROVIDER=local
AUTH_COOKIE_SECURE=false
SERVICE_ROLE=api
DATABASE_PATH=data/returnradar.db
STORAGE_BACKEND=sqlite
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Legacy development-only connector. Merchant connections are configured in Data Connections.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_API_VERSION=2026-07
# Required for hosted saved connections; local development creates data/connector.key.
CONNECTOR_ENCRYPTION_KEY=

# Optional: enable Gemini classification and chat for all data sources.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Production: DEMO_MODE=false, AUTH_PROVIDER=firebase, STORAGE_BACKEND=firestore.
GOOGLE_CLOUD_PROJECT=
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
STORAGE_BUCKET=
CLOUD_TASKS_LOCATION=asia-south1
CLOUD_TASKS_QUEUE=
WORKER_URL=
TASKS_SERVICE_ACCOUNT=

# Empty when Firebase Hosting proxies /api to Cloud Run.
VITE_API_URL=
