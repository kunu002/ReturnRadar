# Reference only. Cloud Run gets these from scripts/deploy-cloud.sh.
# Never upload a real .env, local database, or data/connector.key.
SERVICE_ROLE=api
DEMO_MODE=false
AUTH_PROVIDER=firebase
STORAGE_BACKEND=firestore
GOOGLE_CLOUD_PROJECT=YOUR_GOOGLE_CLOUD_PROJECT_ID
FIREBASE_WEB_API_KEY=YOUR_FIREBASE_WEB_API_KEY
FIREBASE_AUTH_DOMAIN=YOUR_GOOGLE_CLOUD_PROJECT_ID.web.app
CORS_ORIGINS=https://YOUR_GOOGLE_CLOUD_PROJECT_ID.web.app,https://YOUR_GOOGLE_CLOUD_PROJECT_ID.firebaseapp.com
GEMINI_MODEL=gemini-3.1-flash-lite
CLOUD_TASKS_LOCATION=asia-south1
CLOUD_TASKS_QUEUE=returnradar-work
WORKER_URL=https://YOUR_PRIVATE_WORKER_URL.run.app
TASKS_SERVICE_ACCOUNT=returnradar-tasks@YOUR_GOOGLE_CLOUD_PROJECT_ID.iam.gserviceaccount.com
# Inject through Secret Manager, never fill these in a committed file:
# GEMINI_API_KEY <- returnradar-gemini-api-key (pinned enabled version)
# CONNECTOR_ENCRYPTION_KEY <- returnradar-connector-key (stable Fernet key)
# Worker uses SERVICE_ROLE=worker and only the common storage/project/model/secrets.
